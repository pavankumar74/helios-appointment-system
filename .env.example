# Copy to .env and adjust for your environment. Do NOT commit real secrets.

# Database
DB_NAME=helios
DB_USERNAME=helios
DB_PASSWORD=helios
DB_ROOT_PASSWORD=rootpass

# JWT — generate a strong 256-bit base64 secret in production, e.g.:
#   openssl rand -base64 32
HELIOS_JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1kZXYtb25seS1zZWNyZXQtMzJieXRlcyE=

# Allowed frontend origins (comma-separated)
HELIOS_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Seed admin (disable in production)
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@hellodoctor.local
SEED_ADMIN_PASSWORD=Admin@12345
# Seed sample doctors, patients, and appointments on first run
SEED_SAMPLE_ENABLED=true

# Notifications (set MAIL_ENABLED=true and provide SMTP settings to actually send)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@hellodoctor.local

# SMS notifications: provider=log (default, logs only) or twilio (real delivery)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
